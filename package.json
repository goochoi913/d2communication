{
  "name": "d2communication",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:emulators": "NEXT_PUBLIC_FIREBASE_EMULATORS=1 next dev -p 3000",
    "emulators": "npm --prefix functions run build && sh scripts/with-java21.sh firebase emulators:start --project demo-d2communication --only auth,firestore,storage,functions",
    "sync-content": "node scripts/sync-content.mjs",
    "build": "node scripts/sync-content.mjs && next build",
    "preview": "npm run build && serve out -l 4173 --no-clipboard",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:rules": "sh scripts/with-java21.sh firebase emulators:exec --project demo-d2communication --only firestore,storage \"vitest run tests/rules\"",
    "deploy:backend": "firebase deploy --project d2communication --only firestore:rules,firestore:indexes,storage,functions"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^13.0.0",
    "lenis": "^1.3.27",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}

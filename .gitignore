# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firebase-debug.log*

# private source material — kept locally, never committed (the GitHub repo is public).
# The logo originals live here too; exact copies are committed under public/brand/.
/D2 Communication Build Brief.md
/homepage.key
/Screenshot*.png
/d2communication-logo.svg
/d2communication-logo-no-background.svg

# content snapshot fetched from Firestore at build time (scripts/sync-content.mjs)
/src/content/snapshot.json

# Firebase functions build output and emulator logs/data
/functions/lib/
/functions/node_modules/
/.emulator-data/
firestore-debug.log*
ui-debug.log*
storage-debug.log*
database-debug.log*
pubsub-debug.log*
